<mxCell id="c93" value="1  Traveller sends a WhatsApp message" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="1231" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c94" value="2  Meta delivers it to AWS End User Messaging Social" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="1250" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c95" value="3  End User Messaging Social publishes the event to Amazon SNS" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="1269" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c96" value="4  SNS invokes the whatsapp_eum Lambda (dedupe, session, read receipt)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="1288" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c97" value="5  Lambda gets a Cognito token and invokes AgentCore Runtime" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="1231" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c98" value="6  Agent loads Memory and gets an OAuth token from Identity" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="1250" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c99" value="7  Agent calls tools through AgentCore Gateway (MCP)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="1269" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c100" value="8  AgentCore Policy authorizes each tool call (Cedar)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="1288" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c101" value="9  Targets: tools Lambda, Google Places, Tavily, live data APIs" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="1231" width="440" height="18" as="geometry"/></mxCell>
<mxCell id="c102" value="10 Lambda replies with SendWhatsAppMessage" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="1250" width="440" height="18" as="geometry"/></mxCell>
